{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install && pnpm --filter @workspace/discord-bot run build 2>/dev/null || true"
  },
  "deploy": {
    "startCommand": "pnpm --filter @workspace/discord-bot run dev",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
